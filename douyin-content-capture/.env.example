# 抖音内容提取 - 环境配置
# 复制此文件为 .env 并修改配置

# 视频/图文下载输出目录（绝对路径）
# 支持 ~ 展开为用户主目录
# 必须配置此项才能正常使用
# DOUYIN_OUTPUT_DIR=~/Downloads/douyin-captures

# Whisper 模型大小（仅视频转写使用）
# 可选值: tiny / base / small / medium / large-v2 / large-v3
# tiny 最快但精度低，small 是速度与精度的平衡点
DOUYIN_WHISPER_MODEL=small

# 推理设备
# auto: 自动检测（有 CUDA 用 GPU，否则 CPU）
# cpu: 强制使用 CPU
# cuda: 强制使用 GPU
DOUYIN_WHISPER_DEVICE=auto

# 项目源码仓库地址（可选）
# 如果需要使用自己的 fork，取消注释并修改此行
# DOUYIN_REPO_URL=https://github.com/your-username/obsidian-content-capture-backend.git
